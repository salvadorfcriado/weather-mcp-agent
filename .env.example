# Copy to .env and fill in. The .env file is git-ignored — never commit real keys.

# Which LLM backend the agent uses. Only "anthropic" ships in this deliverable;
# additional providers (e.g. OpenAI) are documented in SOLUTION.md as an OCP extension.
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Fast, current default; override with any tool-calling Claude model.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Agent loop ---
# Hard cap on tool-call iterations per user turn (prevents runaway loops).
AGENT_MAX_ITERATIONS=8

# --- Upstream data cache ---
# Current-weather cache TTL in seconds (0 disables weather caching).
# Geocoding is effectively immutable and cached for the whole session.
WEATHER_CACHE_TTL_SECONDS=600

# --- Logging ---
LOG_LEVEL=INFO
